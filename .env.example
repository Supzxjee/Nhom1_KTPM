# DO NOT commit .env. For Railway: configure these in the service Variables tab.
LLM_MODE=gemini
GEMINI_API_KEY=
# Use a model that your Gemini AI Studio account lists as available.
GEMINI_MODEL=gemini-3.5-flash-lite
ADMIN_TOKEN=
# Enable password protection of chatbot, Swagger, and API on the public website.
TEAM_USERNAME=
TEAM_PASSWORD=
# For Railway: create a Volume mounted at /data; set DB_PATH=/data/chatbot.db.
# For local testing: leave unset (default local chatbot.db).
# DB_PATH=/data/chatbot.db
